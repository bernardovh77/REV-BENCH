# build output
build/
build-san/
*.o
*.d

# renders/ holds regenerated output (make render, the rb_cli demos, tools/);
# the images used by the docs live in docs/
renders/*
!renders/.gitkeep

# python caches (tools/)
__pycache__/
.venv-analysis/

# zig compiler caches
.zig-cache/
zig-cache/

# web
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/

# graphify: each machine's own bookkeeping (its AST cache, file times, the folder it
# scanned, a shown-once notice). graph.json, graph.html, GRAPH_REPORT.md and the
# .graphify_analysis/.graphify_labels files are the graph itself and stay committed.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_root
graphify-out/.cloud-cta-shown
# its backups of the graph before a rebuild that regroups it, and the names it gave the
# new groups by itself (only names someone set go in .graphify_labels.json)
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_labels.pending.json

