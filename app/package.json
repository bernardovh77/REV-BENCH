{
  "name": "rev-bench-app",
  "private": true,
  "version": "0.1.0",
  "productName": "Rev-Bench",
  "description": "Rev-Bench: the C engine simulation as a desktop application",
  "author": "bernardovh77",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:ui": "vite build",
    "build:node": "node scripts/bundle-node.mjs",
    "build": "npm run build:ui && npm run build:node",
    "build:native": "cmake-js build --directory native --out native/build",
    "start": "npm run build && electron .",
    "typecheck": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.4",
    "cmake-js": "8.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3",
    "node-api-headers": "1.9.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  }
}
