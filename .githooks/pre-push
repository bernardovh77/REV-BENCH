#!/bin/sh
# Refuses a push while the quick suites fail (stage 127).
#
# A rule that lived only in CLAUDE.md ("every stage ends with all tests green")
# was broken once: a commit went up with the host's suite failing. This runs
# the suites that take minutes, not the whole run; the stage's full run
# (python tools/run_tests.py) is still its last step before the commit.
#
# Enable it once per clone:   git config core.hooksPath .githooks
# Skip it for one push:       RB_SKIP_PREPUSH=1 git push   (say why in the commit or the log)
# Choose the suites:          RB_PREPUSH_SUITES="native python" git push

if [ "${RB_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: skipped (RB_SKIP_PREPUSH=1)" >&2
    exit 0
fi

# Nothing to test when the push only deletes branches or sends nothing new.
sends=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) ;;
        *) sends=1 ;;
    esac
done
[ "$sends" = "1" ] || exit 0

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

# The Python of tools/requirements-dev.txt (docs/workspace.md), else whatever python is there.
python=""
for candidate in "$HOME/rb-venv/Scripts/python.exe" "$HOME/rb-venv/bin/python" python3 python; do
    # It must run: on Windows "python3" can be the Store's stub, which is found but isn't Python.
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys" >/dev/null 2>&1; then
        python=$candidate
        break
    fi
done
if [ -z "$python" ]; then
    echo "pre-push: no Python found; run the tests by hand or set RB_SKIP_PREPUSH=1" >&2
    exit 1
fi

suites=${RB_PREPUSH_SUITES:-native python host}
echo "pre-push: running the quick suites ($suites) before the push" >&2
# shellcheck disable=SC2086
if ! "$python" tools/run_tests.py $suites >&2; then
    echo "pre-push: a suite failed, so nothing was pushed" >&2
    exit 1
fi
exit 0
